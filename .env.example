# ==========================================
# ffmpeg-render-service environment variables
# Copy this file to .env and adjust as needed
# ==========================================

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Base URL used when building the returned videoUrl. In Docker/production,
# set this to the publicly reachable address of this service, e.g.
# https://render.yourdomain.com or http://your-server-ip:3000
PUBLIC_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Video output defaults (can be overridden per-request via "style")
DEFAULT_WIDTH=1080
DEFAULT_HEIGHT=1920
DEFAULT_FPS=30
DEFAULT_CRF=20
DEFAULT_PRESET=medium
AUDIO_BITRATE=192k

# Subtitles
SUB_MAX_CHARS=42
SUB_MAX_LINES=2
SUB_FONT_NAME=DejaVu Sans
SUB_FONT_SIZE=64
SUB_FONT_COLOR=white
SUB_OUTLINE_COLOR=black
SUB_OUTLINE_WIDTH=3
SUB_MARGIN_BOTTOM=120

# Background music
MUSIC_VOLUME=0.1
MUSIC_FADE_IN=2
MUSIC_FADE_OUT=3

# Downloads
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RETRY_DELAY_MS=1500
DOWNLOAD_TIMEOUT_MS=60000
DOWNLOAD_MAX_FILE_SIZE_BYTES=524288000

# FFmpeg
FFMPEG_TIMEOUT_MS=900000

# Cleanup
DELETE_TEMP_AFTER_RENDER=true
MAX_OUTPUT_AGE_HOURS=24

# Text-to-Speech (Piper - local, offline, no API keys / no paid services)
# PIPER_BIN and PIPER_MODELS_DIR are baked in by the Dockerfile and normally
# don't need to be overridden. Uncomment to point at a custom install.
# PIPER_BIN=/opt/piper/piper
# PIPER_MODELS_DIR=/opt/piper/models
# PIPER_DEFAULT_VOICE=en_US-lessac-medium
TTS_MAX_CHARS=5000
TTS_TIMEOUT_MS=60000
TTS_MAX_AUDIO_AGE_HOURS=24

# Directories (optional overrides - defaults are relative to project root)
# TEMP_DIR=/app/temp
# OUTPUT_DIR=/app/output
# SUBTITLES_DIR=/app/subtitles
# LOGS_DIR=/app/logs
# PUBLIC_DIR=/app/public
# AUDIO_DIR=/app/public/audio
